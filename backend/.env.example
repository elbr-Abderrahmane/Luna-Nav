# LUNA NAV Backend Environment Configuration
LUNA_ENV=development
LUNA_DEBUG=true
LUNA_API_PREFIX=/api
LUNA_LOG_LEVEL=INFO

# CORS Origins for Person 1's 3D Frontend (comma-separated)
LUNA_CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# External Module Adapter Modes (set to false once a teammate's module is integrated)
USE_MOCK_TERRAIN=true
USE_MOCK_ASTRONOMY=true
USE_MOCK_DECISION=true
